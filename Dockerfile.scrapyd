# scrapyd image for the shared scraw-ops service.
# Runs every deployed scraw-* egg. Install the union of project runtime deps
# here so deployed spiders can import them; add project-specific deps as needed.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
      "scrapy>=2.12" \
      "scrapy-redis>=0.7.3" \
      "scrapyd>=1.3" \
      "scrapyd-client>=1.3" \
      "psycopg2-binary>=2.9" \
      "pyarrow>=15" \
      "redis>=5"

EXPOSE 6800

CMD ["scrapyd"]
